{
  "name": "gazetta",
  "version": "0.8.0",
  "description": "Stateless CMS for composable websites",
  "keywords": [
    "cms",
    "stateless",
    "composable",
    "hono",
    "templates",
    "fragments",
    "ssr"
  ],
  "homepage": "https://gazetta.studio",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/",
    "admin-dist/"
  ],
  "bin": {
    "gazetta": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./save-etag": {
      "types": "./dist/save-etag.d.ts",
      "import": "./dist/save-etag.js"
    },
    "./editor": {
      "types": "./dist/editor/mount.d.ts",
      "import": "./dist/editor/mount.js"
    },
    "./admin-api": {
      "types": "./dist/admin-api/index.d.ts",
      "import": "./dist/admin-api/index.js"
    },
    "./admin-api/schemas": {
      "types": "./dist/admin-api/schemas/index.d.ts",
      "import": "./dist/admin-api/schemas/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./providers/azure-blob": {
      "types": "./dist/providers/azure-blob.d.ts",
      "import": "./dist/providers/azure-blob.js"
    },
    "./providers/s3": {
      "types": "./dist/providers/s3.d.ts",
      "import": "./dist/providers/s3.js"
    },
    "./workers/cloudflare-r2": {
      "types": "./dist/workers/cloudflare-r2.d.ts",
      "import": "./dist/workers/cloudflare-r2.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gazetta-studio/gazetta-studio.git",
    "directory": "packages/gazetta"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:admin": "vite build -c ../../apps/admin/vite.config.ts --base /admin/ --outDir ../../packages/gazetta/admin-dist --emptyOutDir ../../apps/admin",
    "prepublishOnly": "npm run build && npm run build:admin",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@clack/prompts": "^1.7.0",
    "@floating-ui/dom": "^1.7.6",
    "@hello-pangea/dnd": "^18.0.1",
    "@hono/node-server": "^2.0.8",
    "@rjsf/core": "^6.6.2",
    "@rjsf/utils": "^6.5.2",
    "@rjsf/validator-ajv8": "^6.6.2",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "axe-core": "^4.11.4",
    "file-type": "^22.0.1",
    "hono": "^4.12.28",
    "html-validate": "^11.5.5",
    "isomorphic-dompurify": "^3.18.0",
    "jiti": "^2.7.0",
    "jose": "^6.2.3",
    "jsdom": "^29.1.1",
    "marked": "^18.0.5",
    "music-metadata": "^11.13.0",
    "nanoid": "^5.1.16",
    "openai": "^6.45.0",
    "postcss": "^8.5.16",
    "postcss-prefix-selector": "^2.1.1",
    "sharp": "^0.35.3",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3",
    "@aws-sdk/lib-storage": ">=3",
    "@azure/storage-blob": ">=12",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1083.0",
    "@aws-sdk/lib-storage": "^3.1083.0",
    "@azure/storage-blob": "^12.33.0",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/jsdom": "^28.0.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "fast-check": "^4.9.0",
    "msw": "^2.15.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
